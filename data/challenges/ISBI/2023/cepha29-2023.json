            "url": "https://www.nature.com/articles/s41597-025-05542-3",
            "local_source": "latex_sourcev2/data/evidence_reaudit_20261021/sources/cepha29_aariz_paper_20261021.json"
          }
        },
        {
          "scope": "Official data/rules or dataset-report statement",
