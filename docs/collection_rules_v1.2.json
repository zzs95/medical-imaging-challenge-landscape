  "schema_info": {
    "schema_name": "Medical Imaging Challenge Survey Schema",
    "schema_version": "1.2",
    "language": "English",
    "purpose": "Standardized collection of recent medical imaging challenge metadata, including event affiliation, task theme, anatomy, labels, dataset accessibility, data-use paradigm, evaluation, participation statistics, and provenance."
  },
  "filling_rules": {
    "general_rules": {
      "rules": [
        "Use only information that can be verified from official challenge pages, official papers, official repositories, official dataset pages, or official conference/workshop pages.",
        "Use null when a field cannot be verified. Do not guess or infer missing factual details.",
        "Do not use empty strings, 'unknown', 'N/A', or '-' for missing factual values; use null instead.",
        "Use true/false only when the corresponding fact is explicitly supported. Otherwise use null.",
        "For array fields: use [] only when the absence of that category is confirmed; use null when the information was not found or could not be verified.",
        "A single challenge may contain multiple tasks. Record every official task separately under task_profile.tasks.",
        "Do not force a challenge into a single task category when it is inherently multi-task.",
        "Use ISO date format YYYY-MM-DD whenever a complete date is available.",
        "Keep patient_count, study_count, scan_count, image_count, and case_count separate. Never substitute one for another.",
        "If the source uses an approximate number such as '~850 scans', preserve both the normalized numeric value and the original text.",
        "Preserve provenance for important fields so the record can be audited later."
      ]
    },
    "event": {
      "rules": [
        "Set conference only when the challenge is officially associated with that conference.",
        "If a workshop is optional or independent from the challenge, record that relationship explicitly.",
        "Do not infer the conference from timing alone."
      ],
      "candidate_labels": {
        "event_type": [
          "conference_challenge",
          "workshop_challenge",
          "standalone_challenge",
          "benchmark",
          "shared_task",
